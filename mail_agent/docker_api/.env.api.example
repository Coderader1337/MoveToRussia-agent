# Переменная окружения для API ключа (опционально)
# Если не задана, API будет работать без аутентификации (только для локальной разработки)
API_KEY=your_secure_api_key_here_change_me

# Для test_api.py (опционально; без них тест переписки пропускается)
# TEST_MANAGER_EMAIL=manager@example.com
# TEST_MANAGER_PASSWORD=yandex_app_password
# TEST_CLIENT_EMAIL=client@example.com
# API_URL=http://localhost:8000

# Устойчивость IMAP SEARCH при временных ошибках Yandex (опционально)
# IMAP_SEARCH_RETRIES=20
# IMAP_SEARCH_RETRY_DELAY_SECONDS=1.5
# IMAP_SOCKET_TIMEOUT=60
