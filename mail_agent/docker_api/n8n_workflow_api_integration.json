        "options": {
          "timeout": 300000
        }
      },
      "id": "http-request-node",
      "name": "Get Email Thread from API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Обработка полученных писем\nconst response = $input.first().json;\n\nif (!response.success) {\n  throw new Error(`API Error: ${response.error || 'Unknown error'}`);\n}\n\nconst emails = response.emails || [];\nconst clientEmail = response.client_email;\nconst totalCount = response.total_count;\n\n// Формирование текстового представления переписки для LLM\nlet threadText = `Переписка с клиентом: ${clientEmail}\\n`;\nthreadText += `Всего писем: ${totalCount}\\n\\n`;\nthreadText += '=' .repeat(78) + '\\n\\n';\n\nemails.forEach((email, index) => {\n  threadText += `Письмо ${index + 1} [${email.folder}]\\n`;\n  threadText += `Тема: ${email.subject}\\n`;\n  threadText += `От: ${email.from}\\n`;\n  threadText += `Кому: ${email.to}\\n`;\n  threadText += `Дата: ${email.date}\\n`;\n  threadText += '-'.repeat(78) + '\\n';\n  threadText += email.text_plain + '\\n';\n  threadText += '\\n' + '='.repeat(78) + '\\n\\n';\n});\n\nreturn {\n  json: {\n    success: true,\n    client_email: clientEmail,\n    total_count: totalCount,\n    emails: emails,\n    thread_text: threadText,\n    formatted_for_llm: threadText\n  }\n};"
      },
      "id": "code-node",
      "name": "Process Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "response-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1050, 300]
    }
  ],
