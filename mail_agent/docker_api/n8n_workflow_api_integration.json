      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_COMPUTER_IP:8000/api/v1/emails/thread",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.MAIL_AGENT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "manager_email",
              "value": "={{ $json.manager_email }}"
            },
            {
              "name": "manager_password",
              "value": "={{ $json.manager_password }}"
