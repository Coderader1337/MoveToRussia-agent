# Copy to rag/.env and fill in real values. Never commit the real .env.

# --- API keys ---
VOYAGE_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=

# --- Voyage embeddings ---
VOYAGE_MODEL=voyage-4-large
VOYAGE_OUTPUT_DIMENSION=1024
VOYAGE_BATCH_SIZE=64

# --- DeepSeek LLM (OpenAI-compatible) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.2

# --- Qdrant (self-hosted) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=movetorussia_kb

# --- Data sources (defaults already point at repo-relative paths, override if needed) ---
# MTR_CORPUS_PATH=../mailbox_export_RAG/corpus.jsonl
# MTR_FAQ_CSV_PATH=../knowledge_base/v4/client_faq_review.csv

# --- Retrieval ---
MTR_RETRIEVAL_TOP_K=6
