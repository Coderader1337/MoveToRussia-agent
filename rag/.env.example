# Copy to rag/.env and fill in real values. Never commit the real .env.

# --- API keys ---
VOYAGE_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=

# --- Voyage embeddings ---
VOYAGE_MODEL=voyage-4-large
VOYAGE_OUTPUT_DIMENSION=1024
VOYAGE_BATCH_SIZE=64

# --- DeepSeek LLM (OpenAI-compatible) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.2

# --- Qdrant (self-hosted) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=movetorussia_kb

# --- Data sources (defaults already point at repo-relative paths, override if needed) ---
# MTR_CORPUS_PATH=../mailbox_export_RAG/corpus.jsonl
# MTR_FAQ_CSV_PATH=../knowledge_base/v4/client_faq_review.csv

# --- Yandex Disk supplemental corpus (daily sync via systemd timer) ---
# YANDEX_DISK_TOKEN=           # OAuth access token (get via scripts/get_yandex_disk_token.py)
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_DISK_REMOTE_DIR=/rag_corpus
# MTR_DISK_CORPUS_DIR=data/yandex_disk

# --- Retrieval ---
MTR_RETRIEVAL_TOP_K=6
# MTR_DISK_RESERVE_SLOTS=2   # max official Yandex Disk chunks guaranteed in top-k when score >= MTR_DISK_MIN_SCORE
# MTR_DISK_MIN_SCORE=0.30    # cosine similarity floor for disk slot reservation

# --- Память диалога (контекст треда для follow-up вопросов) ---
MTR_HISTORY_TURNS=4
MTR_HISTORY_TTL_MIN=45

# --- Bot paths (set on VPS; dev instance uses separate stats file) ---
# MTR_STATS_CSV_PATH=/opt/movetorussia/rag-dev/data/usage_stats.csv
# MTR_COMMUNICATION_PRINCIPLES_PATH=/opt/movetorussia/rag-dev/prompt_data/communication_principles.txt
