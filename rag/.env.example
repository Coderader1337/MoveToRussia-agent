# RAG stack (Qdrant + embedder)
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334
QDRANT_PORT=6333
EMBEDDER_URL=http://localhost:8081
EMBEDDER_PORT=8081
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com
VOYAGE_MODEL=voyage-4-large
VOYAGE_OUTPUT_DIMENSION=2048
VOYAGE_OUTPUT_DTYPE=float
VOYAGE_TIMEOUT=120
VOYAGE_RETRIES=3
RAG_COLLECTION=movetorussia_kb

# DeepSeek (LLM для ответов в n8n)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram bot (создайте через @BotFather)
TELEGRAM_BOT_TOKEN=
# Опционально: список chat_id через запятую (пусто = все)
TELEGRAM_ALLOWED_CHAT_IDS=

# n8n — URL сервисов с точки зрения n8n (на VPS в одной docker-сети):
# QDRANT_URL=http://qdrant:6333
# EMBEDDER_URL=http://embedder:8081
